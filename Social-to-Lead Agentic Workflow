<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LaunchFlow - Smart Productivity Platform</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      line-height: 1.6;
      color: #333;
      background: #f8fafc;
    }

    header {
      background: #0f172a;
      color: white;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-size: 15px;
    }

    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 80px 8%;
      flex-wrap: wrap;
      gap: 30px;
    }

    .hero-text {
      flex: 1;
      min-width: 280px;
    }

    .hero-text h1 {
      font-size: 42px;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .hero-text p {
      font-size: 18px;
      margin-bottom: 25px;
      color: #475569;
    }

    .btn {
      display: inline-block;
      padding: 14px 28px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .hero-image {
      flex: 1;
      min-width: 280px;
      text-align: center;
    }

    .hero-image img {
      width: 100%;
      max-width: 500px;
      border-radius: 16px;
    }

    .features {
      padding: 70px 8%;
      background: white;
      text-align: center;
    }

    .features h2 {
      font-size: 32px;
      margin-bottom: 40px;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
    }

    .card {
      background: #f1f5f9;
      padding: 25px;
      border-radius: 14px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .card h3 {
      margin-bottom: 12px;
      color: #0f172a;
    }

    .cta {
      padding: 80px 8%;
      text-align: center;
      background: #2563eb;
      color: white;
    }

    .cta h2 {
      font-size: 34px;
      margin-bottom: 20px;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #0f172a;
      color: white;
    }

    @media (max-width: 768px) {
      .hero-text h1 {
        font-size: 32px;
      }

      nav {
        margin-top: 10px;
      }

      nav a {
        margin: 0 10px;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">LaunchFlow</div>
    <nav>
      <a href="#features">Features</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-text">
      <h1>Boost Your Productivity with LaunchFlow</h1>
      <p>
        A smart productivity platform for students, creators, and startups.
        Manage tasks, automate workflows, and stay ahead every day.
      </p>
      <a href="#" class="btn">Get Started Free</a>
    </div>

    <div class="hero-image">
      <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3" alt="Productivity Platform" />
    </div>
  </section>

  <section class="features" id="features">
    <h2>Why Choose LaunchFlow?</h2>
    <div class="feature-grid">
      <div class="card">
        <h3>Task Management</h3>
        <p>Organize daily work with smart scheduling and reminders.</p>
      </div>
      <div class="card">
        <h3>Automation</h3>
        <p>Save time by automating repetitive tasks and workflows.</p>
      </div>
      <div class="card">
        <h3>Analytics</h3>
        <p>Track progress with clear reports and performance insights.</p>
      </div>
    </div>
  </section>

  <section class="cta" id="contact">
    <h2>Start Your Free Trial Today</h2>
    <p>Join thousands of users growing faster with LaunchFlow.</p>
    <br />
    <a href="#" class="btn">Join Now</a>
  </section>

  <footer>
    <p>© 2026 LaunchFlow. All Rights Reserved.</p>
  </footer>

</body>
</html>
